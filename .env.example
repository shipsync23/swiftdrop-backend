# Copy this file to .env. Never commit .env.
# These local values match the defaults in application.yml, so the app started from
# IntelliJ can connect to the containers without extra setup.
# Use strong values for any shared or production deployment.
DB_NAME=swiftdrop
DB_USERNAME=swiftdrop
DB_PASSWORD=swiftdrop
DB_URL=jdbc:postgresql://localhost:5432/swiftdrop

RABBITMQ_USERNAME=swiftdrop
RABBITMQ_PASSWORD=swiftdrop

# Added in later phases
# JWT_SECRET=at-least-32-random-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
