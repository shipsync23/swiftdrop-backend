# Copy this file to .env. Never commit .env.
# The app reads this file automatically on start-up (spring.config.import in application.yml),
# so running from IntelliJ uses these values too.
# Use strong values for any shared or production deployment.
DB_NAME=swiftdrop
DB_USERNAME=swiftdrop
DB_PASSWORD=swiftdrop
DB_URL=jdbc:postgresql://localhost:5432/swiftdrop

RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=swiftdrop
RABBITMQ_PASSWORD=swiftdrop

# At least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID, Web application)
# Authorised redirect URI: http://localhost:8080/login/oauth2/code/google
# Keep "not-configured" until you have real values (an empty value stops the app from starting).
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Email (MailHog in development) and webhook secret encryption
MAIL_HOST=localhost
MAIL_PORT=1025
WEBHOOK_SECRET_KEY=change-me-to-another-long-random-string
# true: this process also runs the outbox relay, notification and webhook consumers
SWIFTDROP_WORKER_ENABLED=true
