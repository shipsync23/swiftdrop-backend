            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "track",
            "{{trackingNumber}}"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "11. Tracking - unknown number (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/track/SDNOTREAL",
