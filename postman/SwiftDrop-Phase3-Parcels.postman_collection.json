          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destZoneId\": 3,\n  \"weightKg\": 45,\n  \"size\": \"LARGE\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
