{
  "info": {
    "name": "SwiftDrop - Phase 3 Parcels",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login as customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@swiftdrop.lk\",\n  \"password\": \"Password@123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2. List zones (public)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/zones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "zones"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "3. Estimate fee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/parcels/estimate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "parcels",
            "estimate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destZoneId\": 3,\n  \"weightKg\": 3.5,\n  \"size\": \"MEDIUM\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('estimatedFee', pm.response.json().fee); }"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Create parcel (confirm fee)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/parcels",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "parcels"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickupAddress\": \"No. 12, Galle Road, Colombo 03\",\n  \"dropoffAddress\": \"No. 45, Peradeniya Road, Kandy\",\n  \"destZoneId\": 3,\n  \"recipientName\": \"Sunil Bandara\",\n  \"recipientPhone\": \"0771234567\",\n  \"size\": \"MEDIUM\",\n  \"weightKg\": 3.5,\n  \"expectedFee\": {{estimatedFee}}\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const p = pm.response.json();",
              "  pm.collectionVariables.set('parcelId', p.id);",
              "  pm.collectionVariables.set('trackingNumber', p.trackingNumber);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create with old fee (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/parcels",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "parcels"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickupAddress\": \"No. 12, Galle Road, Colombo 03\",\n  \"dropoffAddress\": \"No. 45, Peradeniya Road, Kandy\",\n  \"destZoneId\": 3,\n  \"recipientName\": \"Sunil Bandara\",\n  \"recipientPhone\": \"0771234567\",\n  \"size\": \"MEDIUM\",\n  \"weightKg\": 3.5,\n  \"expectedFee\": 1\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "6. My parcels",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
