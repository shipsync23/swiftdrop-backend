            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"courier1@swiftdrop.lk\",\n  \"password\": \"Password@123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Courier opens customer's parcel (403)",
      "request": {
        "method": "GET",
        "header": [
